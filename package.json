{
  "name": "bwf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "sync": "node --disable-warning=ExperimentalWarning scripts/sync/index.ts",
    "sync:export": "node --disable-warning=ExperimentalWarning scripts/sync/index.ts --only news,images,export --offline",
    "sync:news": "node --disable-warning=ExperimentalWarning scripts/sync/index.ts --only news,export",
    "countries": "node scripts/build-countries.mjs",
    "assets:map": "node --disable-warning=ExperimentalWarning scripts/assets/world-map.ts"
  },
  "dependencies": {
    "@mantine/core": "^9.7.1",
    "@mantine/dates": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-virtual": "^3.14.15",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@iconify-json/solar": "^1.2.13",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/d3-geo": "3.1.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-simplify": "3.0.3",
    "@types/topojson-specification": "1.0.5",
    "@vitejs/plugin-react": "^6.1.1",
    "d3-geo": "3.1.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2003",
    "postcss": "^8.5.29",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "sharp": "^0.35.5",
    "topojson-client": "3.1.0",
    "topojson-simplify": "3.0.3",
    "typescript": "~7.0.2",
    "unplugin-icons": "^24.0.0",
