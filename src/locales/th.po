#: src/pages/tournament/components/players/DisciplineSection.tsx
msgid "{count, plural, one {# entry} other {# entries}} · {seeds, plural, one {# seed} other {# seeds}}"
msgstr "{count, plural, other {ผู้เข้าแข่งขัน # ราย}} · {seeds, plural, other {มือวาง # ราย}}"

#. Number of tournaments in a month of the season calendar
#. Number of tournaments on a calendar, e.g. "12 events"
#: src/pages/calendar/components/MonthSection.tsx
#: src/utils/format.ts
msgid "{count, plural, one {# event} other {# events}}"
msgstr "{count, plural, other {# รายการ}}"

#. Calendar header: number of tournaments being played right now
#: src/pages/calendar/components/Hero.tsx
msgid "{count, plural, one {# live now} other {# live now}}"
msgstr "{count, plural, other {กำลังแข่ง # รายการ}}"

#. Calendar header on phones: number of tournaments being played right now
#: src/pages/calendar/components/Hero.tsx
msgid "{count, plural, one {# live} other {# live}}"
msgstr "{count, plural, other {สด # รายการ}}"

#. Number of badminton matches, e.g. "12 matches"
#: src/utils/format.ts
msgid "{count, plural, one {# match} other {# matches}}"
msgstr "{count, plural, other {# แมตช์}}"

#. Number of times two players or pairs have played each other, e.g. "5 meetings"
#: src/utils/format.ts
msgid "{count, plural, one {# meeting} other {# meetings}}"
msgstr "{count, plural, other {พบกัน # ครั้ง}}"

#. Number of doubles pairs (two players playing together), e.g. "64 pairs"
#: src/utils/format.ts
msgid "{count, plural, one {# pair} other {# pairs}}"
msgstr "{count, plural, other {# คู่}}"

#. Number of players, e.g. "120 players"
#: src/utils/format.ts
msgid "{count, plural, one {# player} other {# players}}"
msgstr "{count, plural, other {# คน}}"

#. Number of rallies (points) played in a badminton match, e.g. "84 points"
#: src/utils/format.ts
msgid "{count, plural, one {# point} other {# points}}"
msgstr "{count, plural, other {# แต้ม}}"

#. Number of seeded players or pairs, e.g. "8 seeds". A seed is a top-ranked entry placed in the draw so they cannot meet early
#. Podium tab, How the seeds did card: number of seeded players or pairs in the event
#: src/pages/tournament/utils.ts
#: src/utils/format.ts
msgid "{count, plural, one {# seed} other {# seeds}}"
msgstr "{count, plural, other {มือวาง # ราย}}"

#. Number of news stories published in a month of the news archive
#. Number of news stories, e.g. "8 stories"
#: src/pages/news/components/ArchiveRow.tsx
#: src/utils/format.ts
msgid "{count, plural, one {# story} other {# stories}}"
msgstr "{count, plural, other {# ข่าว}}"

#. Number of tournament wins (titles), e.g. "3 titles"
#: src/utils/format.ts
msgid "{count, plural, one {# title} other {# titles}}"
msgstr "{count, plural, other {# แชมป์}}"

#. Number of tournaments, e.g. "14 tournaments"
#: src/utils/format.ts
msgid "{count, plural, one {# tournament} other {# tournaments}}"
msgstr "{count, plural, other {# รายการ}}"

#. Note under a video list: some YouTube videos are blocked in the visitor’s country and were left out
#: src/utils/media.ts
msgid "{count, plural, one {# video not available in your region is hidden. You can show it in Settings.} other {# videos not available in your region are hidden. You can show them in Settings.}}"
msgstr "{count, plural, other {ซ่อนวิดีโอ # รายการที่ไม่มีในภูมิภาคของคุณไว้ เปิดแสดงได้ในการตั้งค่า}}"

#. Number of YouTube videos, e.g. "3 videos"
#: src/utils/format.ts
msgid "{count, plural, one {# video} other {# videos}}"
msgstr "{count, plural, other {# วิดีโอ}}"

#. Number of weeks, e.g. how long a player held a ranking: "for 12 weeks"
#: src/utils/format.ts
msgid "{count, plural, one {# week} other {# weeks}}"
msgstr "{count, plural, other {# สัปดาห์}}"

#. Countdown to the World Tour Finals, shown under a big number (the count is shown separately), e.g. "12" / "days to go"
#: src/utils/season.ts
msgid "{count, plural, one {day to go} other {days to go}}"
msgstr "{count, plural, other {วันก่อนถึงรายการ}}"

#. About page tier ladder: unit shown under the big number of tournaments at this level
#: src/pages/about/components/TierLadder.tsx
msgid "{count, plural, one {event} other {events}}"
msgstr "{count, plural, other {รายการ}}"

#. Countdown: the tournament starts in this many days, e.g. "In 5 days"
#: src/utils/tournaments.ts
msgid "{count, plural, one {In # day} other {In # days}}"
msgstr "{count, plural, other {อีก # วัน}}"

#. Button that expands a list to reveal the hidden items
#: src/components/ui/MoreButton.tsx
msgid "{count, plural, one {Show # more} other {Show # more}}"
msgstr "{count, plural, other {แสดงเพิ่มอีก #}}"

#. Countdown: the tournament starts in this many days, e.g. "Starts in 5 days"
#: src/utils/tournaments.ts
msgid "{count, plural, one {Starts in # day} other {Starts in # days}}"
msgstr "{count, plural, other {เริ่มในอีก # วัน}}"

#. Number of doubles pairs shown after filtering, out of the total in the ranking
#: src/pages/rankings/components/FilterBar.tsx
msgid "{count} of {total, plural, one {# pair} other {# pairs}}"
msgstr "{count} จาก {total, plural, other {# คู่}}"

#. Number of players shown after filtering, out of the total in the ranking
#: src/pages/rankings/components/FilterBar.tsx
msgid "{count} of {total, plural, one {# player} other {# players}}"
msgstr "{count} จาก {total, plural, other {# คน}}"

#. Very short countdown tag: the tournament starts in {count} days, e.g. "5d". Use your shortest form
#: src/utils/tournaments.ts
msgid "{count}d"
msgstr "{count} วัน"

#. Past winners: when and where an earlier edition was held, e.g. "14–19 Oct · Odense, Denmark"
#: src/pages/tournament/utils.ts
msgid "{dates} · {city}, {country}"
msgstr "{dates} · {city}, {country}"

#. Selected day on the phone filters button, e.g. “Wed 15 Oct”. {day} is the weekday and day number, {month} the short month
#: src/pages/tournament/components/matches/FilterBars.tsx
msgid "{day} {month}"
msgstr "{day} {month}"

#. Matches tab empty state. {day} is a short day label, e.g. "Wed 15"
#: src/pages/tournament/components/MatchesTab.tsx
msgid "{day} is a rest day with no matches."
msgstr "{day} เป็นวันพัก ไม่มีการแข่งขัน"

#. Screen-reader value of the ranking history slider: date, world ranking (e.g. #3) and ranking points
#: src/pages/player/components/RankChart.tsx
msgid "{day}: {rank}, {points} points"
msgstr "{day}: {rank}, {points} คะแนน"

#. One world ranking of a player, e.g. "Men’s singles world No. 1"
#: src/utils/meta.ts
msgid "{discipline} world No. {rank}"
msgstr "{discipline} มือ {rank} ของโลก"

#. About page tier ladder: number of players or pairs in each discipline’s main draw
#: src/pages/about/summaries.ts
msgid "{DRAW_SIZE} per draw"
msgstr "สายละ {DRAW_SIZE} ราย"

#. Draw tab empty state. {event} is an event name, e.g. Men’s singles. The order of play is the daily match schedule
#: src/pages/tournament/components/DrawTab.tsx
msgid "{event} isn’t in today’s order of play data yet."
msgstr "{event} ยังไม่มีในโปรแกรมการแข่งขันของวันนี้"

#. About page “titles so far” card: tournaments completed this season and titles (one per discipline) won in them
#: src/pages/about/components/TitlesSoFar.tsx
msgid "{events, plural, one {# event} other {# events}} · {titles, plural, one {# title} other {# titles}}"
msgstr "{events, plural, other {# รายการ}} · {titles, plural, other {# แชมป์}}"

#. The two sides of a match, e.g. "Axelsen vs Shi"
#. The two sides of a match, e.g. “Axelsen vs Shi”
#: src/pages/tournament/components/matches/utils.ts
#: src/pages/tournament/components/OverviewTab.tsx
msgid "{home} vs {away}"
msgstr "{home} พบ {away}"

#. When a news story was published: this many hours ago, in a short form, e.g. "3h ago"
#: src/utils/news.ts
msgid "{hours, plural, one {#h ago} other {#h ago}}"
msgstr "{hours, plural, other {# ชม. ที่แล้ว}}"

#. A label and its value in a one-line summary or tooltip, e.g. "Won: 1". Adjust the colon and spacing for your language
#: src/utils/format.ts
msgid "{label}: {value}"
msgstr "{label}: {value}"

#. Live match: how many challenges a side can still make in this game, e.g. "1 of 2 challenges left". A challenge is a player’s request for a video review of a line call (Instant Review)
#: src/utils/live.ts
msgid "{left} of {total, plural, one {# challenge} other {# challenges}} left"
msgstr "ชาเลนจ์เหลือ {left} จาก {total, plural, other {# ครั้ง}}"

#. Compact calendar header: number of tournaments being played right now
#: src/pages/calendar/components/CompactHeader.tsx
msgid "{liveCount, plural, one {# live} other {# live}}"
msgstr "{liveCount, plural, other {สด # รายการ}}"

#: src/pages/player/components/People.tsx
msgid "{matches, plural, one {# match} other {# matches}}"
msgstr "{matches, plural, other {# แมตช์}}"

#. Number of matches played against these opponents
#: src/pages/player/components/People.tsx
msgid "{meetings, plural, one {# meeting} other {# meetings}}"
msgstr "{meetings, plural, other {พบกัน # ครั้ง}}"

#. Tooltip on a match duration, e.g. 42′
#: src/components/ui/Duration.tsx
msgid "{min, plural, one {# minute} other {# minutes}}"
msgstr "{min, plural, other {# นาที}}"

#. Estimated reading time of a news article, in minutes
#: src/pages/news-article/components/ArticleHeader.tsx
msgid "{minutes, plural, one {# min read} other {# min read}}"
msgstr "{minutes, plural, other {อ่าน # นาที}}"

#. Hint over the About page season map when the reader scrolls over it: hold {MOD_KEY} (Ctrl or ⌘) while scrolling to zoom the map
#: src/pages/about/components/SeasonMap.tsx
msgid "{MOD_KEY} + scroll to zoom"
msgstr "{MOD_KEY} + เลื่อนเพื่อซูม"

#. Live score: points won in a row by one side without the opponent scoring
#: src/utils/live.ts
msgid "{n, plural, one {# in a row} other {# in a row}}"
msgstr "{n, plural, other {ติดกัน # แต้ม}}"

#. Count next to the Live now title: matches being played right now
#: src/pages/tournament/components/matches/LiveSection.tsx
msgid "{n, plural, one {# match on court} other {# matches on court}}"
msgstr "{n, plural, other {กำลังแข่ง # แมตช์}}"

#. Head-to-head summary
#: src/components/match/detail/HeadToHead.tsx
msgid "{n, plural, one {# meeting this season} other {# meetings this season}}"
msgstr "{n, plural, other {พบกัน # ครั้งในฤดูกาลนี้}}"

#. News archive month heading: {name} is the month name, {year} is shown in a lighter style
#: src/pages/news/components/ArchiveRow.tsx
msgid "{name} <0>{year}</0>"
msgstr "{name} <0>{year}</0>"

#. Description of an unranked player. {name} e.g. "Kento Momota", {country} e.g. "Japan", {disciplines} e.g. "Men’s singles"
#: src/utils/meta.ts
msgid "{name} from {country}: {disciplines}. Profile, results, matches and ranking history."
msgstr "{name} จาก{country}: {disciplines} ดูโปรไฟล์ ผลการแข่งขัน แมตช์ และประวัติอันดับโลก"

#. Description of a ranked player. {name} e.g. "Viktor Axelsen", {country} e.g. "Denmark", {rankings} e.g. "Men’s singles world No. 1"
#: src/utils/meta.ts
msgid "{name} from {country}: {rankings}. Profile, results, matches and ranking history."
msgstr "{name} จาก{country}: {rankings} ดูโปรไฟล์ ผลการแข่งขัน แมตช์ และประวัติอันดับโลก"

#. Description of a player with no ranking or matches yet. {name} e.g. "Viktor Axelsen", {country} e.g. "Denmark"
#: src/utils/meta.ts
msgid "{name} from {country}. Profile, results, matches and ranking history."
msgstr "{name} จาก{country} ดูโปรไฟล์ ผลการแข่งขัน แมตช์ และประวัติอันดับโลก"

#. Description of a cancelled tournament. {name} e.g. "VICTOR Denmark Open 2026", {level} e.g. "Super 750", {place} e.g. "Odense, Denmark", {dates} e.g. "13–18 October 2026"
#: src/utils/meta.ts
msgid "{name}, a {level} tournament in {place} planned for {dates}, was cancelled."
msgstr "{name} รายการระดับ {level} ที่ {place} ซึ่งกำหนดแข่งขัน {dates} ถูกยกเลิกแล้ว"

#. Description of a finished tournament. {name} e.g. "VICTOR Denmark Open 2026", {level} e.g. "Super 750", {place} e.g. "Odense, Denmark", {dates} e.g. "13–18 October 2026"
#: src/utils/meta.ts
msgid "{name}, a {level} tournament in {place}, {dates}. See the champions, results and draw."
msgstr "{name} รายการระดับ {level} ที่ {place} {dates} ดูแชมป์ ผลการแข่งขัน และสายการแข่งขัน"

#. Description of an upcoming tournament. {name} e.g. "VICTOR Denmark Open 2026", {level} e.g. "Super 750", {place} e.g. "Odense, Denmark", {dates} e.g. "13–18 October 2026"
#: src/utils/meta.ts
msgid "{name}, a {level} tournament in {place}, {dates}. See the players, draw and schedule."
msgstr "{name} รายการระดับ {level} ที่ {place} {dates} ดูรายชื่อนักกีฬา สายการแข่งขัน และโปรแกรมการแข่งขัน"

#. Players tab continent summary: how many countries and entries (players or pairs) it has
#: src/pages/tournament/components/players/ContinentSection.tsx
msgid "{nations, plural, one {# country} other {# countries}} · {count, plural, one {# entry} other {# entries}}"
msgstr "{nations, plural, other {# ประเทศ}} · {count, plural, other {ผู้เข้าแข่งขัน # ราย}}"

#. Past winners card: how the final ended, who lost it and the game scores, e.g. "Retired · vs. Axelsen · 21–15, 3–1". {note} is Walkover or Retired
#: src/pages/tournament/utils.ts
msgid "{note} · vs. {losers} · {games}"
msgstr "{note} · พบ {losers} · {games}"

#. Browser tab title. {page} is the page name (a tournament, player or section), {site} is the site name
#: src/utils/meta.ts
msgid "{page} · {site}"
msgstr "{page} · {site}"

#. Number of tournaments played in the selected season
#: src/pages/player/components/MatchesTab.tsx
msgid "{played, plural, one {# tournament} other {# tournaments}}"
msgstr "{played, plural, other {# รายการ}}"

#. Match stats footer for a game still in progress
#: src/components/match/detail/StatsPanel.tsx
msgid "{points, plural, one {# point played so far} other {# points played so far}}"
msgstr "{points, plural, other {เล่นไปแล้ว # แต้ม}}"

#. Match stats footer
#: src/components/match/detail/StatsPanel.tsx
msgid "{points, plural, one {# point played} other {# points played}}"
msgstr "{points, plural, other {เล่นทั้งหมด # แต้ม}}"

#. World ranking points at the chosen week; pts = points
#: src/pages/player/components/RankChart.tsx
msgid "{points} pts"
msgstr "{points} คะแนน"

#. Head-to-head row: win–loss record this season; {SEASON_YEAR} is the year
#: src/components/match/detail/useMatchInsights.ts
msgid "{SEASON_YEAR} W–L"
msgstr "ชนะ–แพ้ ปี {SEASON_YEAR}"

#. Filtered list count: how many items are shown out of all of them, e.g. "12 of 340 players". {total} already includes the noun
#: src/utils/filter.ts
msgid "{shown} of {total}"
msgstr "{shown} จาก {total}"

#: src/pages/player/components/MediaTab.tsx
msgid "{storyCount, plural, one {# story} other {# stories}}"
msgstr "{storyCount, plural, other {# ข่าว}}"

#. Second clock under a match time shown in the visitor’s time zone: the same moment in the venue’s local time. {time} is e.g. "15:30" or "Wed 15:30"
#: src/utils/match-time.ts
msgid "{time} at the venue"
msgstr "{time} เวลาสนามแข่ง"

#. Second clock under a match time shown in venue time: the same moment in the visitor’s own time zone. {time} is e.g. "09:30" or "Thu 09:30"
#: src/utils/match-time.ts
msgid "{time} your time"
msgstr "{time} เวลาของคุณ"

#. Screen-reader label of a filter dropdown, e.g. “Round: Final”
#: src/pages/tournament/components/MediaTab.tsx
msgid "{title}: {current}"
msgstr "{title}: {current}"

#: src/pages/player/components/People.tsx
msgid "{titles, plural, one {# title} other {# titles}}"
msgstr "{titles, plural, other {# แชมป์}}"

#. About page season card: {done} tournaments finished out of the season’s total
#: src/pages/about/components/SeasonCard.tsx
msgid "{total, plural, one {{done} of # completed} other {{done} of # completed}}"
msgstr "{total, plural, other {จบแล้ว {done} จาก # รายการ}}"

#. Head-to-head summary; {FIRST_SEASON} is the first season with data, e.g. 2018
#: src/components/match/detail/HeadToHead.tsx
msgid "{total, plural, one {# meeting on the World Tour since {FIRST_SEASON}} other {# meetings on the World Tour since {FIRST_SEASON}}}"
msgstr "{total, plural, other {พบกัน # ครั้งใน World Tour ตั้งแต่ปี {FIRST_SEASON}}}"

#. Number of doubles pairs in the ranking list
#: src/pages/rankings/components/FilterBar.tsx
msgid "{total, plural, one {# pair} other {# pairs}}"
msgstr "{total, plural, other {# คู่}}"

#. Number of players in the ranking list
#: src/pages/rankings/components/FilterBar.tsx
msgid "{total, plural, one {# player} other {# players}}"
msgstr "{total, plural, other {# คน}}"

#. Number of tournaments counted in the ranking
#: src/pages/rankings/components/Podium.tsx
msgid "{tournaments, plural, one {# tournament} other {# tournaments}}"
msgstr "{tournaments, plural, other {# รายการ}}"

#: src/pages/player/components/MediaTab.tsx
msgid "{videoCount, plural, one {# video} other {# videos}}"
msgstr "{videoCount, plural, other {# วิดีโอ}}"

#. Overview schedule row on small screens: short date, e.g. “Wed, 15 Oct”. Reorder the weekday, day number and month as your language writes dates
#: src/pages/tournament/components/OverviewTab.tsx
msgid "{weekday}, {dayNum} {month}"
msgstr "{weekday} {dayNum} {month}"

#. Overview schedule row: full date, e.g. “Wednesday, 15 October”. Reorder the weekday, day number and month as your language writes dates
#: src/pages/tournament/components/OverviewTab.tsx
msgid "{weekdayLong}, {dayNum} {monthLong}"
msgstr "{weekdayLong}ที่ {dayNum} {monthLong}"

#. Under the career-best ranking: how many weeks the player held it
#: src/pages/player/components/Hero.tsx
msgid "{weeks, plural, one {for # week} other {for # weeks}}"
msgstr "{weeks, plural, other {นาน # สัปดาห์}}"

#. Tooltip on a seeded player’s result: who won the match against whom
#: src/pages/tournament/utils.ts
msgid "{winner} beat {loser}"
msgstr "{winner} ชนะ {loser}"

#. Accessible label for a won–lost record bar
#: src/pages/player/components/People.tsx
msgid "{wins, plural, one {# win} other {# wins}}, {losses, plural, one {# loss} other {# losses}}"
msgstr "{wins, plural, other {ชนะ # ครั้ง}} {losses, plural, other {แพ้ # ครั้ง}}"

#. When a ranking result was earned: year and ranking week number (wk = week)
#: src/pages/player/components/parts.tsx
msgid "{year} · wk {week}"
msgstr "{year} · สัปดาห์ที่ {week}"

#. When a ranking result was earned (wk = week); not counted means its points don’t count toward the ranking
#: src/pages/player/components/parts.tsx
msgid "{year} · wk {week} · not counted"
msgstr "{year} · สัปดาห์ที่ {week} · ไม่นับคะแนน"

#. Heading of the recent-form strip: Form means the player’s recent results, shown as the last N matches won or lost
#: src/pages/player/components/OverviewTab.tsx
msgid "{year} form · last {count}"
msgstr "ฟอร์มปี {year} · {count} แมตช์ล่าสุด"

#. About page heading of the card mapping the {year} World Tour season
#. Section title: the player’s stats for the current season
#: src/pages/about/components/SeasonFrame.tsx
#: src/pages/player/components/OverviewTab.tsx
msgid "{year} season"
msgstr "ฤดูกาล {year}"

#. Screen-reader label for the About page card with a world map and timeline of the {year} World Tour season
#: src/pages/about/components/SeasonFrame.tsx
msgid "{year} season map"
msgstr "แผนที่ฤดูกาล {year}"

#. Screen-reader label for the About page timeline of the {year} season, one mark per tournament
#: src/pages/about/components/SeasonStrip.tsx
msgid "{year} season timeline"
msgstr "ไทม์ไลน์ฤดูกาล {year}"

