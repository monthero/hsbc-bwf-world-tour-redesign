#: src/pages/tournament/components/PlayersTab.tsx
msgid "World top 10"
msgstr "विश्व टॉप 10"

#. The season-ending tournament for the top 8 of the season ranking in each discipline; an official name
#: src/constants.ts
msgid "World Tour Finals"
msgstr "World Tour Finals"

#. Calendar header subtitle on phones: the season-ending World Tour Finals and its {dates}
#: src/pages/calendar/utils.ts
msgid "World Tour Finals · {dates}"
msgstr "World Tour Finals · {dates}"

#. Main heading of the news page
#: src/pages/news/constants.ts
msgid "World Tour News"
