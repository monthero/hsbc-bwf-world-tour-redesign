#. Head-to-head row: each side’s BWF world ranking
#. Icon label on a ranking tile: the number is the BWF world ranking
#: src/components/match/detail/useMatchInsights.ts
#: src/pages/player/components/Hero.tsx
msgid "World ranking"
msgstr "विश्व रैंकिंग"

#. Accessible label of the slider that steps through the ranking chart week by week
#: src/pages/player/components/RankChart.tsx
msgid "World ranking history"
msgstr "विश्व रैंकिंग इतिहास"

#. Browser tab title for the BWF World Rankings page
#: src/utils/meta.ts
msgid "World rankings"
msgstr "विश्व रैंकिंग"

