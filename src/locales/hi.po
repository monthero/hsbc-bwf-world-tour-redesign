#: src/components/match/detail/useMatchInsights.ts
msgid "World Tour W–L"
msgstr "World Tour जीत–हार"

#. Search result hint: the player’s current BWF world ranking and discipline code, e.g. "WR #3 · MS". WR is short for world ranking; keep it short
#: src/utils/search.ts
msgid "WR #{rank} · {event}"
msgstr "विश्व #{rank} · {event}"

#. Button on the About page season map that zooms the map in
#: src/pages/about/components/MapControls.tsx
